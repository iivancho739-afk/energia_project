# Copia este archivo como ".env" para desarrollo local y completa los valores

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Connection string de Supabase (Project Settings > Database > Connection string > URI)
# Usa el modo "Transaction pooler" (puerto 6543) para producción en Render.
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROYECTO].supabase.co:5432/postgres
